<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is denied by default (no plaintext HTTP/ws to the public
  internet). Localhost is the only exception, so a developer can point
  the app at a loopback PeerJS signalling server during development.

  GH-0.1 / U-6: previously CI forced android:usesCleartextTraffic="true"
  on every release APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
