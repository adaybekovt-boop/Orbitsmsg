# Flutter / Dart build artifacts
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# NB: `.metadata` and `pubspec.lock` are intentionally committed — this is an
# application, not a package. `.metadata` is version-controlled per Flutter's
# own header, and committing `pubspec.lock` pins the exact resolved dependency
# set so CI and local builds are reproducible.

# Generated platform folders. CI recreates these with `flutter create`.
android/
ios/
linux/
macos/
windows/

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Test / coverage output
coverage/
*.lcov
test/.test_coverage.dart

# Local environment files
.env
.env.local
*.key
*.pem

# CI release staging output (artifacts are uploaded, never committed)
dist/

# Claude Code worktrees / local agent scratch
.claude/
