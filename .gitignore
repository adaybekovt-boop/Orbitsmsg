# Flutter / Dart build artifacts
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# NB: `.metadata` and `pubspec.lock` are intentionally committed — this is an
# application, not a package. `.metadata` is version-controlled per Flutter's
# own header, and committing `pubspec.lock` pins the exact resolved dependency
# set so CI and local builds are reproducible.

# Generated platform folders. CI recreates these with `flutter create`.
android/
ios/
linux/
macos/
# windows/ is generated too, BUT we force-track the app icon so a checkout never
# silently builds with the default Flutter icon (the blue logo). `flutter create`
# keeps an existing app_icon.ico, so a normal build picks up the Orbits icon
# without any extra step. Regenerate via tool/windows/restore_app_icon.sh; the
# guard test (test/branding/windows_app_icon_test.dart) fails on the default.
windows/*
!windows/runner/
windows/runner/*
!windows/runner/resources/
windows/runner/resources/*
!windows/runner/resources/app_icon.ico

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Test / coverage output
coverage/
*.lcov
test/.test_coverage.dart

# Local environment files
.env
.env.local
*.key
*.pem

# CI release staging output (artifacts are uploaded, never committed)
dist/

# Claude Code worktrees / local agent scratch
.claude/
